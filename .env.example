# Sanity (existing)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_CAL_USERNAME=

# Resend — transactional email
# Get the key at https://resend.com/api-keys (needs "Sending access")
RESEND_API_KEY=
# Must be an address on a domain/subdomain verified in Resend
RESEND_FROM_EMAIL=hi@send.marcosarmenta.com

# Cloudflare Turnstile — bot protection on the inquiry form
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Comma-separated hostnames siteverify's response.hostname must match.
# Include "localhost" in dev; use only your real domain(s) in production.
TURNSTILE_HOSTNAMES=localhost

# Cal.com booking link shown in the confirmation email
NEXT_PUBLIC_CAL_URL=https://cal.com/marcosarmenta/intro
